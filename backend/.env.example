# Server
PORT=3000
DB_PATH=../data/roleplay.db
SCENARIOS_DIR=../scenarios
FRONTEND_DIR=../frontend

# Allowed origins for CORS when the iframe is embedded in a different host.
# Comma-separated list, or "*" to allow any origin (not recommended in prod).
ALLOWED_ORIGINS=*

# Primary provider key (NanoGPT). Required.
NANOGPT_API_KEY=
# Override the NanoGPT base URL if you proxy it or use an alternate deployment.
# NANOGPT_BASE_URL=https://nano-gpt.com/api

# Optional fallback providers — only needed if a scenario specifies them.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Fallback model used when a scenario does not set one and the student hasn't picked.
DEFAULT_MODEL=chatgpt-4o-latest

# Evaluator model used for the live quest tracker and final evaluation.
# Should be a cheap, fast model. Override per scenario if needed.
EVALUATOR_PROVIDER=nanogpt
EVALUATOR_MODEL=gpt-4o-mini

# Summarizer model used to compress long chat history.
SUMMARIZER_PROVIDER=nanogpt
SUMMARIZER_MODEL=gpt-4o-mini

# Trigger a summary once the conversation has more than this many messages.
SUMMARY_THRESHOLD=30
# How many of the most recent messages to keep verbatim after a summary.
SUMMARY_KEEP_RECENT=10
